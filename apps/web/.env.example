# Public project settings. These are safe to expose to the browser.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-21

# Server-only secret — never prefix this with NEXT_PUBLIC.
SANITY_API_WRITE_TOKEN=

# Google OAuth credentials for the Vercel deployment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WORK_BUDDY_ALLOWED_EMAIL=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
